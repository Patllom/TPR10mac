# ใช้ localhost:4443 เท่านั้น; certificate/key ต้องอยู่นอก Git
server {
    listen 4443 ssl default_server;
    server_name _;
    ssl_certificate ${TPR10_TLS_CERT};
    ssl_certificate_key ${TPR10_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 4443 ssl;
    server_name localhost;
    ssl_certificate ${TPR10_TLS_CERT};
    ssl_certificate_key ${TPR10_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    if ($http_host != "localhost:4443") { return 444; }

    location = /api { return 308 https://localhost:4443/api/; }
    location /api/ {
        proxy_pass http://${TPR10_API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
    }
    location / {
        proxy_pass http://${TPR10_WEB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
    }
}
