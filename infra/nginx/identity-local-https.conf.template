# ใช้ localhost:4443 เท่านั้น; certificate/key ต้องอยู่นอก Git
# ใช้ connection เดิมซ้ำข้าม Docker → host สำหรับ HTTP ปกติ;
# ส่ง Upgrade เฉพาะ WebSocket ของ Next dev ไม่บังคับทุกคำขอให้ upgrade
map $http_upgrade $tpr10_web_connection {
    default upgrade;
    '' '';
}
upstream tpr10_local_web {
    server ${TPR10_WEB_UPSTREAM};
    keepalive 16;
}

server {
    listen 4443 ssl default_server;
    server_name _;
    ssl_certificate ${TPR10_TLS_CERT};
    ssl_certificate_key ${TPR10_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

server {
    listen 4443 ssl;
    server_name localhost;
    ssl_certificate ${TPR10_TLS_CERT};
    ssl_certificate_key ${TPR10_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    if ($http_host != "localhost:4443") { return 444; }

    location = /api { return 308 https://localhost:4443/api/; }
    location /api/ {
        proxy_pass http://${TPR10_API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
    }
    location / {
        proxy_pass http://tpr10_local_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tpr10_web_connection;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
    }
}
